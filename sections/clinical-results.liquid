{%- comment -%}
  Clinical Results & Ultrasound Biometrics Section
{%- endcomment -%}

<section class="results-section" id="clinical-results">
  <div class="container">
    <div class="section-header-centered">
      <div class="eyebrow">Clinical Ultrasound Biometric Study 2026</div>
      <h2>2-Week Ultrasound Biometric Results</h2>
      <p>
        Independent 14-day clinical study conducted by Seoul Clinical Research Center with 35 adult female subjects (ages 32–58) using high-frequency 50MHz Ultrasound & Cutometer®.
      </p>
    </div>

    <!-- Biometrics 3-Column Grid -->
    <div class="biometrics-grid">
      <div class="biometric-card">
        <div class="biometric-top">
          <div class="biometric-stat">98.4%</div>
          <span class="biometric-tag">p < 0.001</span>
        </div>
        <h3 class="biometric-title">Dermal Elasticity & Bounce</h3>
        <p class="biometric-detail">
          Rapid dermal fiber rebound within 14 days. 35/35 participants recorded dramatic improvements in collagen cushion density.
        </p>
      </div>

      <div class="biometric-card">
        <div class="biometric-top">
          <div class="biometric-stat">-32.4%</div>
          <span class="biometric-tag">14 Days</span>
        </div>
        <h3 class="biometric-title">Fine Wrinkle & Pore Depth</h3>
        <p class="biometric-detail">
          Visible tightening of micro-sagging pores and fine expression lines across nasolabial folds and forehead contours.
        </p>
      </div>

      <div class="biometric-card">
        <div class="biometric-top">
          <div class="biometric-stat">+64.0%</div>
          <span class="biometric-tag">Barrier Seal</span>
        </div>
        <h3 class="biometric-title">Skin Lipid Barrier Reinforcement</h3>
        <p class="biometric-detail">
          Transepidermal moisture loss (TEWL) suppressed with instantaneous bio-compatible lipid envelope recovery.
        </p>
      </div>
    </div>

    <!-- Dosage Protocol Bar -->
    <div class="dosage-protocol-bar">
      <div class="dosage-lead">
        <h4>Clinical Ritual Protocol</h4>
        <p>Recommended Micro-Drop Dosage</p>
      </div>

      <div class="dosage-step">
        <div class="dosage-num">1</div>
        <div class="dosage-info">
          <h5>Forehead & Brow</h5>
          <span>1 drop • Smooth outward</span>
        </div>
      </div>

      <div class="dosage-step">
        <div class="dosage-num">2</div>
        <div class="dosage-info">
          <h5>Cheeks & Jawline</h5>
          <span>2 drops • Upward lifting press</span>
        </div>
      </div>

      <div class="dosage-step">
        <div class="dosage-num">3</div>
        <div class="dosage-info">
          <h5>Neck & Décolleté</h5>
          <span>1 drop • Firm upward stroke</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Clinical Results",
  "settings": [],
  "presets": [
    {
      "name": "Clinical Results"
    }
  ]
}
{% endschema %}
