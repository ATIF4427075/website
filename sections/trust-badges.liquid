{%- comment -%}
  Trust Badges & Certifications Bar
{%- endcomment -%}

<section class="trust-bar">
  <div class="container">
    <div class="trust-grid">
      <!-- Badge 1 -->
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="trust-text">
          <h4>Dermatologist Tested</h4>
          <p>Clinically verified 48-hr human patch tests</p>
        </div>
      </div>

      <!-- Badge 2 -->
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="trust-text">
          <h4>K-FDA Approved</h4>
          <p>Dual-functional approved OTC-grade active certificate</p>
        </div>
      </div>

      <!-- Badge 3 -->
      <div class="trust-item">
        <div class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <div class="trust-text">
          <h4>Hypoallergenic Certified</h4>
          <p>Certified non-comedogenic & zero artificial scents</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "Trust Badges"
    }
  ]
}
{% endschema %}
