<section class="breakdown-section" style="padding: 80px 0;">
  <div class="container" style="max-width: 860px;">
    <h1 style="font-family: var(--font-serif); font-size: 2.8rem; color: #ffffff; margin-bottom: 24px;">
      {{ page.title }}
    </h1>
    <div style="color: var(--color-text-body); line-height: 1.7; font-size: 1rem;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
