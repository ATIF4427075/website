{%- comment -%}
  Hero Banner Section - High Converting Clinical Showcase (PKR Rs.)
{%- endcomment -%}

<section class="hero-section" id="hero-serum">
  <div class="container">
    <div class="hero-grid">
      <!-- Left Hero Content -->
      <div class="hero-content">
        <div class="hero-badge-pill">
          <span>{{ section.settings.badge_text | default: 'Bio-Innovation Clinical Breakthrough' }}</span>
        </div>

        <h1 class="hero-title">
          FIRM. SMOOTH.<br>
          <span class="italic-word">RENEW.</span>
        </h1>

        <span class="hero-subhead-pill">
          {{ section.settings.subhead_pill | default: 'REVERSE STRUCTURAL PORE FATIGUE' }}
        </span>

        <p class="hero-description">
          {{ section.settings.description | default: 'Bioengineered high-potency cellular actives: NAD+ and clinical-grade peptide EGF. Engineered to reverse structural pore fatigue, activate deep fibroblasts, and impart incandescent glass-skin fullness.' }}
        </p>

        <div class="hero-actions">
          <a href="#product-top-buy" class="btn-primary">
            <span>Shop The EGF NAD+ Serum</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>

          <a href="#clinical-results" class="btn-secondary">
            <span>Explore Clinical Trials</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </a>
        </div>

        <!-- Social Proof Metrics Ribbon -->
        <div class="hero-metrics-ribbon">
          <div class="metric-item">
            <span class="metric-val">4.9 ★★★★★</span>
            <span class="metric-label">14,230+ Verified Reviews</span>
          </div>

          <div class="metric-item">
            <span class="metric-val">-32.4%</span>
            <span class="metric-label">Dermal Elasticity Spike</span>
          </div>

          <div class="metric-item">
            <span class="metric-val">24/7</span>
            <span class="metric-label">Skin-Barrier Sealing</span>
          </div>
        </div>
      </div>

      <!-- Right Hero Showcase Visual -->
      <div class="hero-visual-wrapper">
        <div class="hero-main-card">
          <img src="{{ 'hero_model.jpg' | asset_url }}" alt="Medicube EGF NAD+ Serum Model" class="hero-model-img" loading="eager">

          <div class="hero-floating-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span>K-DERMA AWARD 2026</span>
          </div>

          <div class="hero-floating-serum">
            <img src="{{ 'hero_product.jpg' | asset_url }}" alt="EGF NAD+ Ampoule Bottle">
            <div class="floating-meta">
              <h4>EGF NAD+ Ampoule</h4>
              <div class="price">
                <span>Rs. 15,900</span>
                <span class="compare-price">Rs. 19,900</span>
              </div>
              <div class="detail">30ml (1.01 fl. oz.) High Potency</div>
            </div>
            <button type="button" class="quick-add-btn" style="width: 32px; height: 32px;" onclick="window.MedicubeTheme.addToCart({ id: 'serum-001', title: 'EGF NAD+ Firming Serum', price: 15900, image: 'assets/hero_product.jpg' })" title="Quick Add">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Bio-Innovation Clinical Breakthrough"
    },
    {
      "type": "text",
      "id": "subhead_pill",
      "label": "Subhead Pill",
      "default": "REVERSE STRUCTURAL PORE FATIGUE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Bioengineered high-potency cellular actives: NAD+ and clinical-grade peptide EGF. Engineered to reverse structural pore fatigue, activate deep fibroblasts, and impart incandescent glass-skin fullness."
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
