{%- comment -%}
  Site Footer Section - Luxury Clinical Derma (PKR)
{%- endcomment -%}

<footer class="site-footer" id="footer-section">
  <div class="container">
    <div class="footer-top-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-brand">
        <h3>
          medicube
          <span style="font-size: 0.65rem; background: rgba(255,42,75,0.18); color: #ff99aa; border: 1px solid var(--color-border); padding: 3px 8px; border-radius: 4px; font-family: var(--font-mono); letter-spacing: 0.1em;">CLINICAL GRADE</span>
        </h3>
        <p>
          Pioneering high-potency Korean dermatological bio-actives. We engineer the cellular architecture through bio-identical peptides, pure NAD+, and clinical ampoules to command authentic skin restoration.
        </p>
        <div class="footer-address">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Seoul Medical Dermatology Research Lab • Gangnam-gu, Seoul, Korea</span>
        </div>
      </div>

      <!-- Col 2: Formulations -->
      <div class="footer-col">
        <h4>Formulations</h4>
        <ul class="footer-links">
          <li><a href="#hero-serum">EGF NAD+ Ampoule Line</a></li>
          <li><a href="#curated-products">EGF NAD+ Cellular Firming Cream</a></li>
          <li><a href="#curated-products">EGF NAD+ Resurfacing Peeling Pads</a></li>
          <li><a href="#curated-products">EGF NAD+ Eye & Neck Lift Concentrate</a></li>
          <li><a href="#curated-products">Clinical Bio-Matrix Kits</a></li>
        </ul>
      </div>

      <!-- Col 3: Science & Care -->
      <div class="footer-col">
        <h4>Science & Care</h4>
        <ul class="footer-links">
          <li><a href="#clinical-results">Ultrasound Biometric Trials</a></li>
          <li><a href="#doctor-endorsement">Medical Advisory Board</a></li>
          <li><a href="#ingredient-breakdown">Bio-Matrix Cellular Journal</a></li>
          <li><a href="#footer-section">Cold-Chain Delivery Policy</a></li>
          <li><a href="#footer-section">30-Day Clinical Guarantee</a></li>
        </ul>
      </div>

      <!-- Col 4: Cellular Reserve Membership -->
      <div class="footer-newsletter-box">
        <h4>Cellular Reserve Membership</h4>
        <p>Subscribe to receive quarterly ultrasound research publications and private batch allocations:</p>
        <form class="footer-form" onsubmit="window.MedicubeTheme.handleVIPSubscribe(event)">
          <input type="email" class="footer-input" placeholder="Enter your clinical email..." required>
          <button type="submit" class="footer-btn">Unlock 15%</button>
        </form>

        <div style="margin-top: 20px;">
          <div style="font-size: 0.68rem; font-family: var(--font-mono); color: #ff99aa; text-transform: uppercase; margin-bottom: 8px; letter-spacing: 0.1em;">
            Security & Verified Trust
          </div>
          <div class="payment-badges">
            <span class="payment-badge">VISA</span>
            <span class="payment-badge">MASTERCARD</span>
            <span class="payment-badge">BANK TRANSFER</span>
            <span class="payment-badge">COD PAKISTAN</span>
            <span class="payment-badge">EASYPAISA / JAZZCASH</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div>
        © 2026 Medicube Clinical Derma Laboratories. All rights reserved.
      </div>
      <div style="display: flex; gap: 16px;">
        <a href="#privacy">Privacy Policy</a>
        <a href="#terms">Terms of Clinical Care</a>
        <a href="#transparency">Transparency in Science</a>
      </div>
    </div>
  </div>
</footer>

