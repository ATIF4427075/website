<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  {%- render 'meta-tags' -%}

  <!-- Fonts & Icons Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    window.ShopifyAssets = {
      'assets/hero_product.jpg': "{{ 'hero_product.jpg' | asset_url }}",
      'assets/product_collagen.jpg': "{{ 'product_collagen.jpg' | asset_url }}",
      'assets/product_pore_pad.jpg': "{{ 'product_pore_pad.jpg' | asset_url }}",
      'assets/product_vita_c.jpg': "{{ 'product_vita_c.jpg' | asset_url }}",
      'assets/ingredient_breakdown.jpg': "{{ 'ingredient_breakdown.jpg' | asset_url }}",
      'assets/hero_model.jpg': "{{ 'hero_model.jpg' | asset_url }}",
      'assets/doctor_portrait.jpg': "{{ 'doctor_portrait.jpg' | asset_url }}"
    };
  </script>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name | handle }}">
  {%- section 'announcement-bar' -%}
  {%- section 'header' -%}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- section 'trust-badges' -%}
  {%- section 'footer' -%}

  {%- render 'cart-drawer' -%}
  {%- render 'admin-control-panel' -%}

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
